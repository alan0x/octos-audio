# Public URL of the control plane. Do not add a trailing slash.
PUBLIC_BASE_URL=https://asr.example.com
# Set the exact HTTPS origin used by the browser.
ALLOWED_ORIGIN=https://asr.example.com
CONTROL_PLANE_PORT=18080

# Generate each secret independently with: openssl rand -hex 32
BRIDGE_SHARED_SECRET=replace-with-at-least-16-random-characters
CLIENT_ACCESS_TOKEN=replace-with-an-independent-client-access-token
# Optional Octos server-to-server integration. This secret must never be sent to
# a browser. When configured, Octos exchanges it for a one-time browser grant.
OCTOS_SERVICE_TOKEN=replace-with-an-independent-octos-service-token
BROWSER_GRANT_TTL_SECONDS=60
SESSION_TTL_SECONDS=900
# Maximum concurrent ASR sessions admitted by the control plane.
SESSION_CAPACITY=50
# A Bridge must answer control-plane WebSocket pings within this time.
BRIDGE_HEARTBEAT_TIMEOUT_SECONDS=15
# Stop sessions that never receive session.ready from the Bridge.
SESSION_START_TIMEOUT_SECONDS=30

# The supported presentation path uses real RTC audio and real on-device ASR.
DEMO_MODE=false

# RTC_PROVIDER selects the media transport: "agora" or "livekit".
RTC_PROVIDER=livekit

# --- LiveKit (self-hosted SFU) ---
# Required when RTC_PROVIDER=livekit.
LIVEKIT_URL=wss://rtc.example.com:9443
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agora (hosted RTC) ---
# Required when RTC_PROVIDER=agora. The App Certificate stays on the server
# only and is used to issue short-lived AccessToken2 credentials.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
RTC_CHANNEL_PREFIX=asr
RTC_CLIENT_UID=1001
RTC_BRIDGE_UID=9001
RTC_TOKEN_TTL_SECONDS=1200
