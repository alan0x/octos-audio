# Current computer: outbound control connection to the VPS.
CONTROL_WS_URL=wss://asr.example.com/ws/bridge
BRIDGE_SHARED_SECRET=replace-with-the-same-random-value-as-vps

# Current, verified OminiX-API Qwen3-ASR contract.
# Single instance:
ASR_URL=http://127.0.0.1:8080/v1/audio/transcriptions
# Or a pool started by start-ominix-pool.sh (comma-separated, round-robin per session).
# Match the port count to OMINIX_POOL_SIZE:
# ASR_URLS=http://127.0.0.1:8080/v1/audio/transcriptions,http://127.0.0.1:8081/v1/audio/transcriptions
ASR_HEALTH_URL=http://127.0.0.1:8080/health
ASR_PROTOCOL=octos-json
ASR_LANGUAGE=Chinese
ASR_MODEL=qwen3-asr
ASR_STARTUP_WAIT_SECONDS=120

# Safety cap on concurrent sessions in this bridge process.
BRIDGE_MAX_SESSIONS=64

# Optional TTS: dedicated OminiX instance started by start-ominix-tts.sh.
# When unset, the speak endpoint reports "TTS is not configured".
# Chinese preset voices: serena (warm female), uncle_fu (mature male),
# dylan (Beijing male), eric (Sichuan male), vivian (edgy young female).
TTS_URL=http://127.0.0.1:8090/v1/audio/speech
TTS_VOICE=serena
TTS_SPEED=1.0
# Keep empty unless needed: a long instruct distorts prosody and is not
# counted in the EOS-steering target, which can truncate speech mid-text.
TTS_INSTRUCT=
TTS_LANGUAGE=chinese
# TTS sampling controls. Current OminiX-API ignores these fields (its
# SpeechRequest has no temperature/top_p/seed) and samples with the model's
# generation_config.json (temperature 0.2, top_p 0.8, no fixed seed); they are
# sent for servers that honour them. Retries use seed + attempt.
TTS_TEMPERATURE=0.2
TTS_TOP_P=0.8
TTS_SEED=42
# The bridge splits long text into clause-aligned chunks of at most
# TTS_MAX_CHUNK_CHARS characters, one OminiX request each, so long segments do
# not drift in pace or fall silent and drop text. Chunks that come back with a
# long silent tail or an implausibly fast rate are retried up to
# TTS_MAX_ATTEMPTS times in total. false = legacy single request.
TTS_AVOID_COMMA_SPLIT=true
TTS_MAX_CHUNK_CHARS=40
TTS_MAX_ATTEMPTS=3

LOG_LEVEL=INFO
VAD_THRESHOLD_DBFS=-38
